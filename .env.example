import express from 'express';
import cors from 'cors';
import dotenv from 'dotenv';
import OpenAI from 'openai';

dotenv.config();

const app = express();
const PORT = process.env.PORT || 4000;

app.use(cors());
app.use(express.json());

const openai = process.env.OPENAI_API_KEY
  ? new OpenAI({ apiKey: process.env.OPENAI_API_KEY })
  : null;

app.get('/api/health', (_, res) => {
  res.json({
    ok: true,
    provider: openai ? 'openai' : 'mock',
    message: 'JARVIS API bereit',
  });
});

app.post('/api/chat', async (req, res) => {
  const { message, provider = 'auto' } = req.body || {};

  if (!message || typeof message !== 'string') {
    return res.status(400).json({ error: 'Message is required.' });
  }

  try {
    const chosenProvider = provider === 'auto'
      ? (openai ? 'openai' : (process.env.OLLAMA_BASE_URL ? 'ollama' : 'mock'))
      : provider;

    if (chosenProvider === 'openai' && openai) {
      const completion = await openai.chat.completions.create({
        model: process.env.OPENAI_MODEL || 'gpt-4o-mini',
        messages: [
          { role: 'system', content: 'Du bist ein hilfsbereiter JARVIS-ähnlicher Assistent.' },
          { role: 'user', content: message },
        ],
        temperature: 0.7,
      });

      const answer = completion.choices?.[0]?.message?.content || 'Keine Antwort erhalten.';
      return res.json({ answer, provider: 'openai' });
    }

    if (chosenProvider === 'ollama' && process.env.OLLAMA_BASE_URL) {
      const ollamaRes = await fetch(`${process.env.OLLAMA_BASE_URL}/api/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: process.env.OLLAMA_MODEL || 'llama3.1',
          messages: [{ role: 'user', content: message }],
          stream: false,
        }),
      });

      if (!ollamaRes.ok) {
        throw new Error('Ollama request failed');
      }

      const data = await ollamaRes.json();
      const answer = data.message?.content || 'Keine Ollama-Antwort erhalten.';
      return res.json({ answer, provider: 'ollama' });
    }

    const answer = `Ich bin im Mock-Modus aktiv. Für echte KI-Antworten setze OPENAI_API_KEY oder OLLAMA_BASE_URL. Deine Frage war: "${message}"`;
    return res.json({ answer, provider: 'mock' });
  } catch (error) {
    console.error(error);
    return res.status(500).json({
      error: 'KI-Anfrage fehlgeschlagen.',
      details: error.message,
    });
  }
});

app.listen(PORT, () => {
  console.log(`JARVIS API listening on http://localhost:${PORT}`);
});
